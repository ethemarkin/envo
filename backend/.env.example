# Copy to backend/.env for local development. Example values only.
ENVO_ENVIRONMENT=development
ENVO_DATABASE_URL=postgresql+asyncpg://envo:envo@localhost:5432/envo

# At least 32 characters. Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
ENVO_SECRET_KEY=change-me-change-me-change-me-change-me

# Local development runs over plain http; keep true everywhere else.
ENVO_COOKIE_SECURE=false

# Public URL of the dashboard, used in invitation and CLI login links.
ENVO_FRONTEND_URL=http://localhost:5173


# Master key (KEK) for envelope encryption: 32 random bytes, base64. Keep it
# outside the database and back it up separately; without it the stored
# values cannot be decrypted. Generate:
#   python -c "import os,base64; print(base64.b64encode(os.urandom(32)).decode())"
# ENVO_MASTER_KEY_FILE can point to a mounted file instead.
ENVO_MASTER_KEY=
ENVO_MASTER_KEY_ID=k1
# During rotation, previous keys as "id:base64,id:base64".
ENVO_RETIRED_MASTER_KEYS=

# Outgoing e-mail for invitations (optional). Without a host, invitations are
# still created and the inviter sees the link to share it themselves.
# For local testing: docker run -p 1025:1025 -p 8025:8025 axllent/mailpit
ENVO_SMTP_HOST=
ENVO_SMTP_PORT=587
ENVO_SMTP_USERNAME=
ENVO_SMTP_PASSWORD=
ENVO_SMTP_STARTTLS=true
ENVO_SMTP_FROM=Envo <envo@localhost>
