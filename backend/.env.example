# Copy to backend/.env for local development. Example values only.
ENVO_ENVIRONMENT=development
ENVO_DATABASE_URL=postgresql+asyncpg://envo:envo@localhost:5432/envo

# At least 32 characters. Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
ENVO_SECRET_KEY=change-me-change-me-change-me-change-me

# Local development runs over plain http; keep true everywhere else.
ENVO_COOKIE_SECURE=false

# The Vite dev server proxies /api to the backend, so both live on :5173.
ENVO_FRONTEND_URL=http://localhost:5173
ENVO_API_URL=http://localhost:5173

# Google login (optional). Authorized redirect URI in Google Cloud Console:
#   http://localhost:5173/api/auth/google/callback
ENVO_GOOGLE_CLIENT_ID=
ENVO_GOOGLE_CLIENT_SECRET=
